# Copy this file to .env and fill in your values
# cp .env.example .env

# Server
PORT=3000

# Auth — choose any strong random string for JWT_SECRET
JWT_SECRET=change-me-to-a-long-random-string
APP_PASSCODE=your-passcode-here

# Schwab token encryption key — must be exactly 64 hex characters (32 bytes)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Schwab OAuth
# Get these from developer.schwab.com
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=http://localhost:3000/schwab/callback

# Google Sheets
# Option 1 (recommended): path to the downloaded service account JSON file
GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json
# Option 2: paste the entire service account JSON as a single line
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Cron schedule (default: 6am weekdays)
# Format: minute hour day-of-month month day-of-week
SYNC_CRON=0 6 * * 1-5
